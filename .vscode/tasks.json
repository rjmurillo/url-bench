{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "-c",
                "Release",
                "-p:PedanticMode=true",
                "-p:GenerateFullPaths=true",
                "-clp:NoSummary"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "format",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "format"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "format:check",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "format",
                "--verify-no-changes"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "test",
                "--configuration",
                "Release",
                "--settings",
                "./build/targets/tests/test.runsettings",
                "-p:PedanticMode=true",
                "-p:GenerateFullPaths=true",
                "-clp:NoSummary"
            ],
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build:non-pedantic",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "-c",
                "Release",
                "-p:GenerateFullPaths=true",
                "-clp:NoSummary"
            ],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test:non-pedantic",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "test",
                "--configuration",
                "Release",
                "--settings",
                "./build/targets/tests/test.runsettings",
                "-p:GenerateFullPaths=true",
                "-clp:NoSummary"
            ],
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "verify",
            "type": "shell",
            "command": "echo",
            "args": [
                "Running build, format, and tests (Release, PedanticMode=true)..."
            ],
            "dependsOn": [
                "format:check",
                "build",
                "test"
            ],
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "verify:non-pedantic",
            "type": "shell",
            "command": "echo",
            "args": [
                "Running build, format, and tests (Release, PedanticMode=false)..."
            ],
            "dependsOn": [
                "format",
                "build:non-pedantic",
                "test:non-pedantic"
            ],
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ]
}